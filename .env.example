# Cadena de conexión a la base de datos (PRIVADA: solo servidor)
DATABASE_URL=
# Clave con la que se firman las sesiones (PRIVADA: solo servidor)
AUTH_SECRET=
# URL base de la API (PÚBLICA: llega al navegador)
NEXT_PUBLIC_API_URL=
# Etiqueta del entorno visible en la interfaz: development | preview | production (PÚBLICA)
NEXT_PUBLIC_APP_ENV=
# DSN de Sentry para errores de servidor (solo servidor; en Vercel y en .env.local)
SENTRY_DSN=
# DSN de Sentry para errores de navegador (el mismo valor; NEXT_PUBLIC_ porque llega al cliente)
NEXT_PUBLIC_SENTRY_DSN=
