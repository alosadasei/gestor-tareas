# Cadena de conexión a la base de datos (PRIVADA: solo servidor)
# En local, con `docker compose up -d`: postgresql://dev:dev@localhost:5432/gestor_tareas_dev
DATABASE_URL=
# BD exclusiva de los tests de integración: se VACÍA en cada test. Sin ella, esos tests se saltan.
# En local: postgresql://dev:dev@localhost:5432/gestor_tareas_test
TEST_DATABASE_URL=
# Clave con la que se firman las sesiones (PRIVADA: solo servidor)
AUTH_SECRET=
# URL base de la API (PÚBLICA: llega al navegador)
NEXT_PUBLIC_API_URL=
# Etiqueta del entorno visible en la interfaz: development | preview | production (PÚBLICA)
NEXT_PUBLIC_APP_ENV=
# DSN de Sentry para errores de servidor (solo servidor; en Vercel y en .env.local)
SENTRY_DSN=
# DSN de Sentry para errores de navegador (el mismo valor; NEXT_PUBLIC_ porque llega al cliente)
NEXT_PUBLIC_SENTRY_DSN=
# Nivel de los logs estructurados: trace | debug | info | warn | error | silent (por defecto info)
LOG_LEVEL=
