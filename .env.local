# Cadena de conexión a la base de datos (PRIVADA: solo servidor)
DATABASE_URL=postgres://dev:dev@localhost:5432/gestor_tareas_dev
# Clave con la que se firman las sesiones (PRIVADA: solo servidor)
AUTH_SECRET=clave-de-juguete-solo-para-desarrollo
# URL base de la API (PÚBLICA: llega al navegador)
NEXT_PUBLIC_API_URL=http://localhost:3000/api
# Etiqueta del entorno visible en la interfaz (PÚBLICA)
NEXT_PUBLIC_APP_ENV=development
