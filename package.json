    "db:studio": "prisma studio",
    "storage:cors": "tsx scripts/configurar-cors.ts"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.65.1",
